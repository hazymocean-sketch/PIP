# Copy to .env (never commit .env). All values are server-side only.

# PostgreSQL connection string (local Postgres, or your independent Supabase project)
DATABASE_URL=postgres://postgres@localhost:5432/pip

# Secret used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional: set to "true" when served over HTTPS (Vercel sets NODE_ENV=production which also enables secure cookies)
# COOKIE_SECURE=true

# --- Research integrations (optional; leave blank until you have keys) ---
# Search provider: tavily | brave | (blank = manual research mode)
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# AI provider for summaries/extraction: anthropic | openai | (blank = none)
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
